# Caddy nur als interner Verteiler, wenn TLS ein vorgeschalteter Proxy macht (z. B. Plesk).
# In .env setzen:
#   CADDYFILE=./deploy/Caddyfile.plesk
#   HTTP_BIND=127.0.0.1
#   HTTP_PORT=8080
#   HTTPS_BIND=127.0.0.1
#   HTTPS_PORT=8443

{
	admin off
	auto_https off
}

# Kein Hostname-Matching: der vorgeschaltete Proxy setzt Host/Forwarded-Header.
:80 {
	encode zstd gzip

	reverse_proxy frontend:80 {
		health_uri /ready
		health_interval 30s
	}

	header {
		-Server
	}

	log {
		output stdout
		format console
	}
}
