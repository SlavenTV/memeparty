# Produktions-Konfiguration fuer den eigenen Server.
# Kopieren nach .env und Werte ersetzen:  cp .env.production.example .env

# Domain ohne Protokoll und ohne Slash. DNS-A-Record muss auf den Server zeigen.
DOMAIN=memeparty.example.com
# Mailadresse fuer Let's Encrypt (Ablaufwarnungen).
ACME_EMAIL=du@example.com
# Muss exakt https://<DOMAIN> sein, sonst schlagen Origin-Pruefung und WebSockets fehl.
PUBLIC_ORIGIN=https://memeparty.example.com

# Datenbankpasswort: nur URL-sichere Zeichen, z. B.  openssl rand -hex 32
POSTGRES_PASSWORD=BITTE_ERSETZEN
# Admin-Adressen, kommasepariert. Ohne diesen Eintrag gibt es keine Administration.
ADMIN_EMAILS=du@example.com

# Ports des Servers (Standard 80/443). Nur aendern, wenn davor ein Proxy laeuft.
HTTP_PORT=80
HTTPS_PORT=443

# Image-Quelle fuer docker compose pull (CI baut diese Tags).
GHCR_OWNER=slaventv
IMAGE_TAG=latest
