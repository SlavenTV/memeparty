{
  "name": "memeparty",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @memeparty/server\" \"npm run dev -w @memeparty/web\"",
    "build": "npm run build -w @memeparty/web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test:e2e": "playwright test",
    "test:local": "node --import tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "10.3.0",
    "@prisma/client": "6.12.0",
    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "^0.45.1",
    "fastify": "5.12.5",
    "ioredis": "5.8.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.4",
    "sharp": "^0.35.5",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "zod": "3.25.76",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@tailwindcss/vite": "4.1.14",
    "@types/node": "24.7.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.4",
    "prettier": "^3.6.2",
    "prisma": "6.12.0",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
